# Groq API (free tier) - used for root-cause classification (ambiguous cases) and Hinglish message generation
GROQ_API_KEY=your_groq_key_here

# Razorpay TEST MODE keys only - https://dashboard.razorpay.com (switch to Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

# If GROQ_API_KEY is not set, the agent falls back to rule-based classification/templates
# so you can develop and demo without any API key at all.
